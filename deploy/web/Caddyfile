# The site's own server, behind the edge proxy (deploy/edge/). It serves the
# Vite build, passes the API to gunicorn, and sets the security headers. They
# live here, in the repository, because the last time they lived in a hosting
# provider's file they were deleted along with it.
{
	admin off
	auto_https off
	servers {
		# The edge proxy reaches us over the Docker network. Without this the
		# client's address and the https it arrived on would be replaced by
		# the proxy's own, and Django would see every pupil as one http client.
		# Its address alone (deploy/edge/compose.yml): other projects share
		# that network, and trusting them would let one forge a client address
		# past the sign-in throttles.
		trusted_proxies static 10.200.0.2
	}
}

:80 {
	encode zstd gzip

	# The policy is an allow-list: anything the browser fetches from a host not
	# named here fails, quietly, with only a console message. Adding a script,
	# an iframe or a fetch to a new host means adding the host here.
	#   accounts.google.com  the Sign in with Google button (lib/googleAuth.js)
	#   translate.googleapis the calendar's translations (CalendarView.jsx)
	#   wasm-unsafe-eval     the Draco decoder for the 3D models (/draco/)
	#   worker-src blob:     three.js runs that decoder in a Blob worker
	#   connect-src blob:    GLTFLoader fetches a model's embedded textures (/space-game)
	@site not path /falcon9-simulator/*
	header @site Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' blob: data: https://accounts.google.com/gsi/ https://translate.googleapis.com; frame-src 'self' https://accounts.google.com/gsi/ https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

	# The Falcon 9 lab is a separate prebuilt app in an iframe, on our origin, so
	# what it loads can read a pupil's tokens. It reads satellites from CelesTrak
	# and loads MediaPipe hand tracking — pinned to one version in its bundle,
	# and only the MediaPipe packages are allowed from jsDelivr.
	@simulator path /falcon9-simulator/*
	header @simulator Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net/npm/@mediapipe/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: mediastream:; connect-src 'self' https://celestrak.org https://cdn.jsdelivr.net/npm/@mediapipe/; worker-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

	# Deferred, so they replace what Django sends rather than doubling it.
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# The camera is the AR sky view and the Falcon 9 hand tracking.
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	# Django's own admin has no limit on sign-in attempts and nothing on the
	# site needs it: staff use /admin-panel, which signs in through the
	# throttled API. Whoever needs /admin/ runs it locally against the same
	# database (docs/TEAM.md).
	@django_admin path /admin /admin/*
	handle @django_admin {
		respond 404
	}

	@django path /api/* /static/*
	handle @django {
		# Uploads are 2 MB at most (apps/validators.py). The whole body is read
		# here before gunicorn sees it, so a client that sends it a byte at a
		# time holds a Caddy goroutine, not one of the API's twelve threads.
		request_body {
			max_size 10MB
		}
		reverse_proxy api:8000 {
			request_buffers 10MB
		}
	}

	# Vite puts a content hash in every file name under /assets/.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Files only: without this the SPA fallback below would answer any
	# /falcon9-simulator/ path with the main app under the simulator's policy.
	handle /falcon9-simulator/* {
		root * /srv
		file_server
	}

	# Everything else is the single-page app: a file if there is one, and
	# index.html for the routes React draws. no-cache is revalidate, not
	# re-download — the next deploy is picked up on the next visit.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
