SECRET_KEY=generate_via_python_-c_"import_secrets;print(secrets.token_urlsafe(50))"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Defaults to CORS_ALLOWED_ORIGINS. Set it only if the admin at /admin/ is
# reached on some other origin.
CSRF_TRUSTED_ORIGINS=
# Opt-in, and think before you do: a regex broad enough to match your own
# preview builds also matches every other page hosted on the same domain.
CORS_ALLOWED_ORIGIN_REGEXES=
TIME_ZONE=Asia/Tashkent

# ── Database ─────────────────────────────────────────────────────────────────
# Leave this blank and Django writes to backend/db.sqlite3 — a file on this one
# machine. Every account, product, order and message lives there and nowhere
# else, so it is lost with the machine and cannot be shared between developers.
# Point it at a hosted Postgres to change that; the URL is all this needs.
DB_URL=

# Shared cache. Without it the sign-in codes and the rate limits fall back to a
# table in the database above, which works but is slower than it needs to be.
REDIS_URL=

# ── Sending e-mail ───────────────────────────────────────────────────────────
# Leave all of this blank and every message is printed to the server log and
# delivered to nobody. That is fine on a laptop and useless to a child who has
# forgotten their password, so a real mail server is what the account flows
# need before they mean anything.
#
# Gmail, which is what this project uses: turn on two-factor authentication on
# the account, then create an app password at
# https://myaccount.google.com/apppasswords — sixteen letters, no spaces. Your
# own Google password does not work here and must not be put in this file.
#
# EMAIL_BACKEND named as SMTP with EMAIL_HOST empty refuses to start, rather
# than accepting mail it cannot send.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
# Seconds before a mail server that stopped answering releases the worker that
# is waiting on it. A code is sent from inside the request that asked for it.
EMAIL_TIMEOUT=10

# Where the front end runs, used only for the convenience links inside those
# messages. Blank is a valid answer: the code in the message is what proves
# anything, and a link is refused unless it points at an origin already listed
# in CORS_ALLOWED_ORIGINS above.
FRONTEND_URL=http://localhost:3000

# ── Cloudflare R2 — uploaded files ───────────────────────────────────────────
# Avatars and product photographs. Leave blank and they are written to
# backend/media/ on this machine instead. This stores *files*: accounts,
# products and orders are rows in the database above, not objects in R2.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_R2_CUSTOM_DOMAIN=

# Private messaging between users, most of whom are minors. Off unless someone
# has reviewed the feature against the duty of care it implies — see ticket B1
# and docs/HANDOVER.md. The moderation floor (screening, reporting, blocking,
# moderator deletion, rate limits, a consent step) is in place either way.
DM_ENABLED=false
# NASA APOD key for the space-data proxy (api.nasa.gov); DEMO_KEY is used when empty, but it allows only 30 requests/hour per IP.
NASA_API_KEY=
