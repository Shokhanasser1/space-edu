# The database. This is the file the 2026-08-22 credential exposure was about;
# see docs/SECURITY-INCIDENT-2026-08-22.md. CI fails the build if a *.sqlite3
# is tracked, but by then it is already in someone's history.
backend/db.sqlite3
*.sqlite3

# Secrets. .env.example is the committed one and carries no values.
.env
.env.*
!.env.example
backend/.env
frontend/.env

# Python
#
# No trailing slash: `backend/venv/` matches a directory and nothing else, so a
# *symlink* named `venv` — which is how a git worktree shares one environment
# with the main clone — slipped past it and was committed as a link to an
# absolute path on one developer's machine. Anyone who pulled it had their own
# venv replaced by a broken link.
backend/venv
backend/.venv
__pycache__/
*.pyc

# Django-generated
backend/media/
backend/staticfiles/

# Frontend
# No trailing slash, for the same reason as `backend/venv` above.
frontend/node_modules
frontend/dist/
frontend/coverage/

# Browser-automation output (snapshots, console logs) from Playwright MCP
.playwright-mcp/

# AI tooling — 31 files of it, three compiled .pyc, turned CI red once already
.agent/
.claude/

# OS
.DS_Store
Thumbs.db

# The 8k texture tier: 1-8 MB a file, generated by frontend/scripts/convert-textures.py
# and served from the deploy's static dir or VITE_ASSET_BASE, never from git.
frontend/public/textures/8k_*
