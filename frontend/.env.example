# The API this front end talks to. Both are read at build time, so a change
# here needs a rebuild, not a reload.
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# The Gemini key lives on the backend only (apps/ai). Never put it in a
# VITE_* variable: Vite inlines those into the public bundle.

# The Google OAuth *client id*, the same value as GOOGLE_OAUTH_CLIENT_ID in
# backend/.env. It ends in .apps.googleusercontent.com and it is public by
# design — it appears in the page source of every site that offers this button,
# and it ships in the bundle here on purpose.
#
# The client *secret* has no part in this. The flow verifies a signed assertion
# from Google on the server, so there is nothing to keep. If something asks you
# to put a Google secret in a VITE_ variable, it is wrong twice over.
#
# Leave it blank and the Google button is not rendered at all: no script tag, no
# request to accounts.google.com, and the password form beside it is unaffected.
VITE_GOOGLE_CLIENT_ID=
