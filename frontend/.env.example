# The API this front end talks to. Both are read at build time, so a change
# here needs a rebuild, not a reload.
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# The Gemini key lives on the backend only (apps/ai). Never put it in a
# VITE_* variable: Vite inlines those into the public bundle.
